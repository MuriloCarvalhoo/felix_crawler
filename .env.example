# Copie para .env (não versionado). O binário não lê .env sozinho: use `make dev`
# ou `set -a; . ./.env; set +a` antes de executar.

# dev | prod. Sem FELIX_ENV o servidor assume prod (fail-closed), que exige
# DATABASE_URL explícita sem as credenciais de dev, FELIX_PUBLIC_URL https,
# cookie Secure e desativa /api/v1/dev. Para desenvolvimento local, mantenha dev.
FELIX_ENV=dev
FELIX_BIND=127.0.0.1:8090
# Usuário precisa ser membro do papel felix_app (ver deploy/postgres-init.sql).
# felix:felix é só do compose de dev; em prod é recusado.
DATABASE_URL=postgres://felix:felix@127.0.0.1:55433/felix
# Origem pública: links em e-mails e Origin aceita nas mutações.
FELIX_PUBLIC_URL=http://127.0.0.1:8090
# Build da SPA (npm --prefix frontend run build).
FELIX_FRONTEND_DIR=frontend/dist
# Proxies cujo X-Real-IP / X-Forwarded-For é aceito (IPs ou CIDRs separados por
# vírgula). Vazio = loopback (127.0.0.0/8 e ::1), ex.: nginx na mesma máquina.
FELIX_TRUSTED_PROXIES=
# Troca de plano pago sem provedor de pagamento (true/false).
# Vazio = true em dev e false em prod (em prod só é possível ir para o Gratuito).
FELIX_PLANO_MANUAL=

# Portal da Transparência (CGU). Vazio desativa a integração.
FELIX_TRANSPARENCIA_KEY=
FELIX_TRANSPARENCIA_URL=https://api.portaldatransparencia.gov.br

# E-mail real (opcional). Sem SMTP, os e-mails ficam só na caixa de saída do banco.
# Ex.: smtps://usuario:senha@smtp.exemplo.com.br:465
FELIX_SMTP_URL=
FELIX_EMAIL_FROM=

# Testes: banco administrativo (superusuário) onde são criados bancos temporários.
FELIX_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55433/postgres

RUST_LOG=felix_server=info,tower_http=info
