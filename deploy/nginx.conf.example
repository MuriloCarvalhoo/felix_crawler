# Modelo nginx do Felix SaaS. Incluir as zonas no bloco http do nginx e
# configurar TLS para o domínio real (FELIX_PUBLIC_URL=https://...).
# O felix-server só aceita X-Real-IP/X-Forwarded-For de proxies listados em
# FELIX_TRUSTED_PROXIES (padrão: loopback, este nginx na mesma máquina).
limit_req_zone $binary_remote_addr zone=felix_requests:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=felix_connections:10m;

server {
    listen 443 ssl;
    http2 on;
    server_name felix.exemplo.com.br;
    # ssl_certificate     /etc/letsencrypt/live/felix.exemplo.com.br/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/felix.exemplo.com.br/privkey.pem;

    client_max_body_size 21m;
    client_body_timeout 20s;
    large_client_header_buffers 4 8k;
    limit_conn felix_connections 16;
    limit_req zone=felix_requests burst=20 nodelay;
    limit_req_status 429;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $http_host;
        # Sobrescreve o que o cliente mandou: o servidor usa X-Real-IP do proxy confiável.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }
}

server {
    listen 80;
    server_name felix.exemplo.com.br;
    return 301 https://$host$request_uri;
}
